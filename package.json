{
  "name": "tracebound",
  "version": "0.1.0",
  "description": "Suspect-link traceability for Jira (Forge app). Supports evidence for design-control traceability (IEC 62304, ISO 14971, ISO 26262 style).",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:engine": "node --test \"test/engine/*.test.js\"",
    "lint": "eslint --ext .js,.jsx src test",
    "forge:lint": "forge lint",
    "test:backend": "node --test \"test/backend/*.test.js\"",
    "test:frontend": "node --test \"test/frontend/*.test.js\""
  },
  "devDependencies": {
    "@forge/cli": "16.0.0",
    "esbuild": "0.28.2",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "@forge/api": "^8.5.1",
    "@forge/bridge": "^7.4.0",
    "@forge/events": "^3.0.11",
    "@forge/kvs": "^2.1.3",
    "@forge/react": "^12.6.0",
    "@forge/resolver": "^2.0.2",
    "react": "^18.2.0"
  }
}
